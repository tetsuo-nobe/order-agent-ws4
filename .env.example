# ローカル開発用: このファイルを .env.local にコピーして値を設定する
# Amplify Hosting では CloudFormation（infra/amplify-hosting.yaml）で同じ名前の環境変数を設定する

# AgentCore Runtime ARN（agentcore status）
VITE_AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-west-2:123456789012:runtime/xxxx
# AgentCore Runtime のリージョン
VITE_AGENT_REGION=us-west-2
# Cognito（tool スタックの Outputs UserPoolId / UserPoolClientId）
VITE_COGNITO_USER_POOL_ID=us-west-2_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
